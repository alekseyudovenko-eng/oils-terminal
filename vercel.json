{
  "crons": [
    {
      "path": "/api/cron/news-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-snapshot?retry=1",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/market-report",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/daily-update",
      "schedule": "30 10 * * 1-5"
    },
    {
      "path": "/api/cron/usda-sync",
      "schedule": "0 18 14 * *"
    },
    {
      "path": "/api/cron/gtt-sync",
      "schedule": "0 6 1-11 * *"
    },
    {
      "path": "/api/cron/comtrade-sync",
      "schedule": "30 6 12 * *"
    }
  ]
}
